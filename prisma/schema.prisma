generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  category    String
  brand       String
  price       Int
  oldPrice    Int?
  stock       Int      @default(0)
  image       String
  shortDesc   String
  description String
  specs       String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Slide {
  id          Int      @id @default(autoincrement())
  heading     String
  description String
  image       String
  btn1Label   String?
  btn1Link    String?
  btn2Label   String?
  btn2Link    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
